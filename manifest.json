{
  "id": "/onlyfrens/",
  "name": "OnlyFrens",
  "short_name": "OnlyFrens",
  "description": "Red social efímera y privada para tus amigos cercanos.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0b8afe",
  "categories": [
    "social"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "prefer_related_applications": false,
  "related_applications": [],
  "icons": [
    {
      "src": "./assets/opengraph/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./assets/opengraph/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./assets/opengraph/icon-1254.png",
      "sizes": "1254x1254",
      "type": "image/png"
    },
    {
      "src": "./assets/opengraph/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshots/auth-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Inicio de sesión de OnlyFrens"
    },
    {
      "src": "./assets/screenshots/auth-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Inicio de sesión de OnlyFrens en escritorio"
    }
  ],
  "shortcuts": [
    {
      "name": "Notificaciones",
      "url": "./#notifications",
      "icons": [
        {
          "src": "./assets/shortcuts/notifications.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Amigos",
      "url": "./#friends",
      "icons": [
        {
          "src": "./assets/shortcuts/friends.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mi perfil",
      "url": "./#profile",
      "icons": [
        {
          "src": "./assets/shortcuts/profile.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
